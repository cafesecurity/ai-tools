{
  "name": "youtube-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A read-only, single-owner MCP server for your own YouTube channel's analytics",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "build:e2e": "wrangler deploy --dry-run --outdir .wrangler/e2e",
    "test:e2e": "npm run build:e2e && vitest run -c vitest.e2e.config.ts",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@modelcontextprotocol/client": "2.4.0",
    "miniflare": "5.20261110.1-beta",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.160.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
